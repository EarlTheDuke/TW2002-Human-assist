# TW2K-AI environment variables
#
# Copy this file to `.env` (ignored by git) or export these in your shell.
# Only the provider you intend to use needs to be set.

# ---------- xAI (Grok) ----------
# Default recommended provider.
XAI_API_KEY=xai-your-key-here
TW2K_XAI_MODEL=grok-4-1-fast-reasoning

# ---------- OpenAI ----------
# OPENAI_API_KEY=sk-your-key-here
# TW2K_OPENAI_MODEL=gpt-4o-mini

# ---------- Anthropic ----------
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# TW2K_ANTHROPIC_MODEL=claude-sonnet-4-5-20250929   # or claude-sonnet-4-6-... when available

# ---------- TinyBox / Kimi (Open WebUI router) ----------
# All-Kimi 3-player: copy these into `.env`, paste your Open WebUI key,
# then run:  powershell -File scripts/run_3x_kimi.ps1
# Kimi is ONLY on /api. Do not use /ollama/v1 or /v1 (SSO).
# TW2K_CUSTOM_BASE_URL=https://tinybox.silverstarindustries.com/api
# TW2K_CUSTOM_MODEL=kimi-k2.5
# TW2K_CUSTOM_API_KEY=sk-your-openwebui-key
# TW2K_TINYBOX_API_KEY=sk-your-openwebui-key
# TW2K_CUSTOM_MAX_TOKENS=12000
# TW2K_CUSTOM_THINK_CAP_S=600

# ---------- Custom / OpenAI-compatible endpoint ----------
# TW2K_CUSTOM_BASE_URL=https://your-endpoint/v1
# TW2K_CUSTOM_API_KEY=your-key-here
# TW2K_CUSTOM_MODEL=qwen3.5:122b
# Per-slot URL/key for mixed endpoints (POST /control/restart ``agents[]``):
#   {"provider":"custom","model":"qwen3.5:122b","custom_base_url":"https://tinybox.../ollama/v1","custom_api_key":"sk-..."}
# Per-turn LLM timeout for custom (local Qwen 32B often needs 180–600s).
# TW2K_CUSTOM_THINK_CAP_S=300
# Ollama: context slots (KV). Localhost URLs auto-send num_ctx=32768; override or disable:
#   TW2K_CUSTOM_NUM_CTX=65536   # larger obs + output; needs more VRAM
#   TW2K_CUSTOM_NUM_CTX=0       # omit options.num_ctx (server default only)
# Daemon-wide default (optional): OLLAMA_CONTEXT_LENGTH=32768


# ---------- Cursor Agent CLI (Composer, etc.) ----------
# Requires the `agent` binary from https://cursor.com/install
#   PowerShell: irm 'https://cursor.com/install?win32=true' | iex
# Then: agent login   OR set:
# CURSOR_API_KEY=your-cursor-api-key
#
# TW2K_CURSOR_MODEL=composer-2-fast
# TW2K_CURSOR_CLI=     # optional full path if `agent` is not on PATH
# TW2K_CURSOR_WORKSPACE=   # optional repo root (defaults to process cwd)
# TW2K_CURSOR_THINK_CAP_S=180   # optional per-turn timeout override
# TW2K_CURSOR_CMDLINE_BUDGET=30000   # if system+obs exceeds this, minimal prompt is used (Windows limit)

# ---------- External harness (Grok Bot seats via /harness/v1) ----------
# Seats flagged with `tw2k serve --external P3,P4` are driven by out-of-process
# bots over loopback REST with a per-seat bearer token. Tokens are generated on
# first boot and stored in the gitignored tokens file; never commit them.
# TW2K_EXTERNAL_TIMEOUT_S=120            # per-turn deadline; timeout -> WAIT + AGENT_ERROR
# TW2K_EXTERNAL_TOKENS_FILE=.tw2k/external_tokens.json
# TW2K_EXTERNAL_TOKEN_P3=                # optional explicit per-seat override
# TW2K_HARNESS_ALLOW_REMOTE=0            # 1 = accept non-loopback clients (off by default)
# TW2K_SPECTATOR_TOKEN=                  # when set, /, /state, /events, /ws, /play, /control, /api need it
#                                        # (open /spectate?token=... once in a browser). run_hosted_grokbot.ps1 sets it.
# TW2K_PUBLIC_BASE_URL=                  # base URL bots should call back to (turn_due webhook); e.g. the tunnel URL
# TW2K_GROKBOT_WEBHOOK_URL=              # POST turn_due here when an external seat's turn starts
# TW2K_GROKBOT_WEBHOOK_FULL_OBS=0        # 1 = include the full Observation in the webhook (default: brief only)

# ---------- Provider selection (optional) ----------
# Forces a provider instead of auto-detecting from the keys above.
# Values: auto | xai | openai | anthropic | custom
# TW2K_PROVIDER=xai

# ---------- Encoding (Windows-only; avoids UnicodeEncodeError on console I/O) ----------
# PYTHONIOENCODING=utf-8
# PYTHONUTF8=1
